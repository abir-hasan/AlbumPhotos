{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":dependencyDashboard",
    ":semanticCommits"
  ],
  "baseBranches": ["main"],
  "labels": ["dependencies"],
  "prHourlyLimit": 0,
  "prConcurrentLimit": 0,
  "packageRules": [
    {
      "description": "compose-rules 0.5.0+ requires detekt 2.x. Remove this rule after migrating to detekt 2.",
      "matchPackageNames": ["io.nlopez.compose.rules:detekt"],
      "allowedVersions": "<0.5.0"
    }
  ]
}
